# ESP32-P4 rev 3.x profile.
CONFIG_ESP32P4_REV_MIN_300=y
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_SPEED=250
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1

# ---- esp_board_manager 设备/外设层 Kconfig ----
# board 组件代码直接使用 dev_*/periph_* 类型; 这 58 个开关全部默认 n,
# 不启用则伞头 esp_board_manager_includes.h 不包含对应设备头文件,
# 编译报 unknown type (dev_audio_codec_handles_t 等, CI 44913800275).
# 按工厂板卡配置全量启用 (多启的驱动仅多编译, 不影响功能).
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_BUTTON_SUPPORT=y
CONFIG_ESP_BOARD_DEV_BUTTON_SUB_ADC_MULTI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_BUTTON_SUB_ADC_SINGLE_SUPPORT=y
CONFIG_ESP_BOARD_DEV_BUTTON_SUB_CUSTOM_SUPPORT=y
CONFIG_ESP_BOARD_DEV_BUTTON_SUB_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUB_CSI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUB_DVP_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CAMERA_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_CUSTOM_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_DSI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_I80_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_PARLIO_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_RGB_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_RGB_3WIRE_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_ETHERNET_SUPPORT=y
CONFIG_ESP_BOARD_DEV_ETHERNET_SUB_EMAC_RGMII_SUPPORT=y
CONFIG_ESP_BOARD_DEV_ETHERNET_SUB_EMAC_RMII_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUB_SDMMC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_SPIFFS_SUPPORT=y
CONFIG_ESP_BOARD_DEV_GPIO_CTRL_SUPPORT=y
CONFIG_ESP_BOARD_DEV_GPIO_EXPANDER_SUPPORT=y
CONFIG_ESP_BOARD_DEV_KNOB_SUPPORT=y
CONFIG_ESP_BOARD_DEV_KNOB_SUB_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_I2C_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LED_STRIP_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LED_STRIP_SUB_RMT_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LED_STRIP_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LEDC_CTRL_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LITTLEFS_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LITTLEFS_SUB_FLASH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LITTLEFS_SUB_SDMMC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LITTLEFS_SUB_SPI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_POWER_CTRL_SUPPORT=y
CONFIG_ESP_BOARD_DEV_POWER_CTRL_SUB_CUSTOM_SUPPORT=y
CONFIG_ESP_BOARD_DEV_POWER_CTRL_SUB_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_ADC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_ANACMPR_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_DAC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_DSI_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LDO_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LEDC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_MCPWM_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_PCNT_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_RMT_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SDM_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SPI_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_UART_SUPPORT=y
