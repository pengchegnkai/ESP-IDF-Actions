# ESP32-P4 rev 3.x profile.
CONFIG_ESP32P4_REV_MIN_300=y
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_SPEED=250
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1

# ---- esp_board_manager 设备/外设层 Kconfig (最小集) ----
# board 组件代码直接使用 dev_*/periph_* 类型; 这些 Kconfig 选项全部默认 n,
# 不启用则伞头 esp_board_manager_includes.h 不包含设备头文件 (unknown type 编译错误).
# 按全树实际引用 + 设备驱动传递依赖闭包确定:
#   dev_display_lcd -> periph_spi (spi 子路径), DSI 子类型 = MIPI-DSI 面板
#   dev_audio_codec -> periph_adc (MIC), periph_i2c (控制), periph_i2s (数据)
#   dev_ledc_ctrl   -> periph_ledc (背光)
#   dev_lcd_touch   -> periph_i2c (GT911), I2C 子类型
# 注意: 不要全量启用 -- P4 无 DAC, 0.7.6 的 periph_dac.c 用 IDF6 新 API
# (dac_oneshot_*), 在 IDF 5.5 上编译失败 (CI 44915985902).
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_DSI_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LEDC_CTRL_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_ADC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LEDC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SPI_SUPPORT=y
