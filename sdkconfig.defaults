# 目标芯片由 CI 工作流的 matrix 指定 (idf.py set-target 语义)
#
# ESP32-P4 (微雪 ESP32-P4-WIFI6-Touch-LCD-4.3):
#   封装内 32MB PSRAM —— LVGL/DPI 面板缓冲必须放这里, 不开会 ESP_ERR_NO_MEM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# 中文字库: LVGL tiny_ttf 解码器 (从 SD 卡 TTF 文件按需渲染, 数据驻留 PSRAM)
CONFIG_LV_USE_TINY_TTF=y

# 启动画面品牌大字 (内置 Montserrat 48px; 中文模式下用 TTF 字体渲染)
# 注意: 字体 Kconfig 符号不带 USE_ 前缀 (库选项才带, 如 LV_USE_TINY_TTF)
CONFIG_LV_FONT_MONTSERRAT_48=y

# Vela 界面各号字: 英文模式 (无 SD 字库) 回退这些内置字号, 缺字体会掉到 14px
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_16=y

# ---- WiFi (ESP-Hosted / SDIO, C6 协处理器) ----
# 参考微雪工厂固件 (brookesia) 配置: 加大 TX 缓冲并开 AMPDU
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_WIFI_RMT_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y

# 自定义分区表: factory 扩到 2M (IDF 默认 single_app 仅 1M, 固件已 ~1.07MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# flash 32MB (官方示例同款; BSP 默认只给 2MB, 装不下 2M factory 分区)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# LVGL 分配器: 自定义后端 (sys_ui/src/sys_ui_mem.c), 全部 LVGL 内存走 PSRAM 堆。
# 内置池是静态 .bss, 在 P4 上会吃掉内部 DRAM (512KB 池 → .dram0.bss 518KB →
# 启动 32K DMA 池保留失败 abort); 64KB 池又不够中文字形缓存 (stbtt assert)。
# 详见 sys_ui_mem.c 头注释。
CONFIG_LV_USE_CUSTOM_MALLOC=y

# ESP-IDF 6.1 已知问题 (IDFGH-17859): P4 的 sleep clock ICG 初始化在应用
# 静态内存占用较高时分配 REGDMA 描述符失败, app_main 前 abort 重启循环。
# 该选项 (v6.1-rc1 起) 跳过这个可选的深睡时钟门控 —— 常亮 UI 设备用不到深睡
CONFIG_PM_SLEEP_CLK_ICG_ENABLE=n
