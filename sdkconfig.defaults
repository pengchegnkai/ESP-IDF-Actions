# 目标芯片由 CI 工作流的 matrix 指定 (idf.py set-target 语义)
#
# ESP32-P4 (微雪 ESP32-P4-WIFI6-Touch-LCD-4.3):
#   封装内 32MB PSRAM —— LVGL/DPI 面板缓冲必须放这里, 不开会 ESP_ERR_NO_MEM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# 中文字库: LVGL tiny_ttf 解码器 (从 SD 卡 TTF 文件按需渲染, 数据驻留 PSRAM)
CONFIG_LV_USE_TINY_TTF=y

# 启动画面品牌大字 (内置 Montserrat 48px; 中文模式下用 TTF 字体渲染)
# 注意: 字体 Kconfig 符号不带 USE_ 前缀 (库选项才带, 如 LV_USE_TINY_TTF)
CONFIG_LV_FONT_MONTSERRAT_48=y

# 自定义分区表: factory 扩到 2M (IDF 默认 single_app 仅 1M, 固件已 ~1.07MB)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# flash 32MB (官方示例同款; BSP 默认只给 2MB, 装不下 2M factory 分区)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# LVGL 内置分配器池: 默认 64KB 不够中文字形缓存 (128 字形×~1.3KB≈166KB + 对象树),
# 字形 malloc 失败会触发 stbtt assert 重启。扩到 512KB (单块 >16KB 自动落 PSRAM)
CONFIG_LV_MEM_SIZE_KILOBYTES=512
