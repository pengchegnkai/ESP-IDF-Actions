# 目标芯片由 CI 工作流的 matrix 指定 (idf.py set-target 语义)
#
# ESP32-P4 (微雪 ESP32-P4-WIFI6-Touch-LCD-4.3):
#   封装内 32MB PSRAM —— LVGL/DPI 面板缓冲必须放这里, 不开会 ESP_ERR_NO_MEM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# 中文字库: LVGL tiny_ttf 解码器 (从 SD 卡 TTF 文件按需渲染, 数据驻留 PSRAM)
CONFIG_LV_USE_TINY_TTF=y

# 启动画面品牌大字 (内置 Montserrat 48px; 中文模式下用 TTF 字体渲染)
CONFIG_LV_USE_FONT_MONTSERRAT_48=y
