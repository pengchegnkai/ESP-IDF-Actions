# ESP32-P4 专属配置 (仅 target=esp32p4 时生效)
#
# SD 卡挂载失败(空卡/未格式化)时自动 FAT 格式化, 免去手动格式化
# (该选项来自微雪 BSP 的 Kconfig, 其他芯片目标没有此选项)
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=y

# 分区表含内嵌字库 fonts 分区 (板载 32MB flash);
# c6/s3 flash 较小, 沿用基础 sdkconfig.defaults 里的 partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_p4.csv"

# ---- OTA (双 OTA 分区 + 自动回滚, 见 components/sys_ota) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# 32MB flash: ota_1/ota_data 在 16MB 以上, 24bit cache 地址映射不到 → 需 32bit 地址
# (否则 esp_ota_get_state_partition 时 flash_mmap 报 "out of range for 24bit flash mapping")
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y

# ---- USB / FIDO2 (TinyUSB, 见 sys_hal USB 层; 符号已由 security agent 核实) ----
#
# 引脚核实结论 (本板 Type-C "USB OTG" 口 = P4 HS UTMI PHY, 无 GPIO 编号):
#   微雪 4.3 的 USB OTG Type-C (原理图 H2) 接 USBD_P/USBD_N —— ESP32-P4 的
#   专用 USB 2.0 High-Speed OTG 引脚 (芯片引脚 50/49, 不经 GPIO 矩阵, 不能作
#   普通 IO); 出厂固件 (brookesia) 的 sdkconfig.defaults 无 TinyUSB 配置可抄。
#   出处:
#     https://docs.waveshare.com/ESP32-P4-WIFI6-Touch-LCD-4.3 (Pinout 表:
#       pins 25/27 USBD_N/USBD_P "dedicated USB 2.0 High-Speed OTG pins of
#       the ESP32-P4 (chip pins 49 and 50). They are not connected to the
#       GPIO matrix ... cannot be used as regular I/O")
#     https://files.waveshare.com/wiki/ESP32-P4-WIFI6-Touch-LCD-4.3/ESP32-P4-WIFI6-Touch-LCD-4.3-schematic.pdf
#   注意: P4 的两个 Full-Speed PHY 里 FS2 的 GPIO26/27 在本板被 LCD 背光/复位
#   占用, FS1 的 GPIO24/25 只在 40PIN 排针引出, 都不接 USB 口 → 必须走 HS 口。
# esp_tinyusb 在 P4 上的默认端口即 TINYUSB_PORT_HIGH_SPEED_0 (tinyusb_default_config.h),
# HS PHY 引脚固定于芯片内部, 故此处无需任何 USB 引脚 Kconfig, 只开 HID 接口:
# CONFIG_TINYUSB_HID_COUNT=1  → CFG_TUD_HID=1, FIDO CTAP2 HID (64B IN/OUT 报告)
# 版本锁定 esp_tinyusb 2.x (见 components/sys_hal/idf_component.yml, ^2.2.1):
# 已核实 2.x 的 Kconfig (TINYUSB_HID_COUNT 等) 与 tinyusb_driver_install() API。
CONFIG_TINYUSB_HID_COUNT=1
